LANGSMITH_PROJECT="banking-concierge"
LANGSMITH_TRACING="true"

LANGSMITH_WORKSPACE_ID=""
LANGSMITH_API_KEY=""
BASE_URL="https://gateway.smith.langchain.com/openai/v1"

OPENAI_API_KEY=""

# Optional override; defaults to gpt-4o-mini for the agent
CONCIERGE_MODEL="gpt-4o-mini"

# Tags every root run with metadata.environment so dashboards and run rules can
# separate real traffic from synthetic. Defaults to "development" ("loadgen" in
# scripts/load_generation.py); set to "production" or "staging" when deploying.
ENVIRONMENT="development"

# Only needed for scripts/load_generation.py --mode remote
LANGGRAPH_DEPLOYMENT_URL=""
